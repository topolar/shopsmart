    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
