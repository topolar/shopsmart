{
  "name": "@shopsmart/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migration:run": "tsx src/migration-cli.ts run",
